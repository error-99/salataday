      "note": "সব চুপচাপ পড়ুন।",
      "sub_steps": [
        {"sub_id": "sana", "title": "Sana (ছানা)", "arabic": "سُبْحَانَكَ اللَّهُمَّ وَبِحَمْدِكَ وَتَبَارَكَ اسْمُكَ وَتَعَالَى جَدُّكَ وَلَا إِلٰهَ غَيْرُكَ", "bangla": "সুবহানাকা আল্লাহুম্মা ওয়া বিহামদিকা..."},
        {"sub_id": "taawwudh", "title": "Ta'awwudh", "arabic": "أَعُوذُ بِاللَّهِ مِنَ الشَّيْطَانِ الرَّجِيمِ", "bangla": "আউযু বিল্লাহি মিনাশ শাইতানির রাজীম।"},
        {"sub_id": "bismillah", "title": "Bismillah", "arabic": "بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ", "bangla": "বিসমিল্লাহির রাহমানির রাহীম।"},
        {"sub_id": "fatiha", "title": "Surah Al-Fatiha", "arabic": "الْحَمْدُ لِلَّهِ رَبِّ الْعَالَمِينَ ... وَلَا الضَّالِّينَ", "bangla": "আলহামদু লিল্লাহি রাব্বিল আলামীন... আমীন।"},
        {"sub_id": "surah_first", "title": "Surah Al-Kafirun", "arabic": "قُلْ يَا أَيُّهَا الْكَافِرُونَ ... لَكُمْ دِينُكُمْ وَلِيَ دِينِ", "bangla": "কুল ইয়া আইয়ুহাল কাফিরূন... লাকুম দীনুকুম ওয়ালিয়া দীন।"}
      ]
    },
    {"id": "ruku_first", "title": "Ruku - 1st Rakat", "image": "/images/ruku.png", "audio": "/audio/ruku.mp3", "arabic": "سُبْحَانَ رَبِّيَ الْعَظِيمِ", "bangla": "সুবহানা রাব্বিয়াল আযীম (৩+ বার)"},
    {"id": "qawmah_first", "title": "Qawmah - 1st Rakat", "image": "/images/qawmah.png", "audio": "/audio/qawmah.mp3", "arabic": "سَمِعَ اللَّهُ لِمَنْ حَمِدَهُ رَبَّنَا وَلَكَ الْحَمْدُ", "bangla": "সামি'আল্লাহু লিমান হামিদাহ। রাব্বানা লাকাল হামদ।"},
    {"id": "sujood_first_one", "title": "First Sujood - 1st Rakat", "image": "/images/sujood.png", "audio": "/audio/sujood.mp3", "arabic": "سُبْحَانَ رَبِّيَ الْأَعْلَى", "bangla": "সুবহানা রাব্বিয়াল আ'লা (৩+ বার)"},
